table DimDate
	lineageTag: DimDate-tag-001

	partition DimDate = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("../../data/marts/dim_date.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Promote = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
			in
			    Promote

	column date
		lineageTag: DimDate-date
		dataType: string
		summarizeBy: none

	column year
		lineageTag: DimDate-year
		dataType: string
		summarizeBy: none

	column month
		lineageTag: DimDate-month
		dataType: string
		summarizeBy: none

	column day
		lineageTag: DimDate-day
		dataType: string
		summarizeBy: none

	column weekday
		lineageTag: DimDate-weekday
		dataType: string
		summarizeBy: none

	column week
		lineageTag: DimDate-week
		dataType: string
		summarizeBy: none

