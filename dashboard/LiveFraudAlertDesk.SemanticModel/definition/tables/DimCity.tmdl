table DimCity
	lineageTag: DimCity-tag-001

	partition DimCity = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("../../data/marts/dim_city.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Promote = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
			in
			    Promote

	column city
		lineageTag: DimCity-city
		dataType: string
		summarizeBy: none

