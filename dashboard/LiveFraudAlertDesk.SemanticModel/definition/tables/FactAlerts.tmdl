table FactAlerts
	lineageTag: FactAlerts-tag-001

	partition FactAlerts = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("../../data/cleaned/fact_alerts.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Promote = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
			in
			    Promote

	column alert_id
		lineageTag: FactAlerts-alert_id
		dataType: string
		summarizeBy: none

	column txn_id
		lineageTag: FactAlerts-txn_id
		dataType: string
		summarizeBy: none

	column alert_ts
