table MartRule
	lineageTag: MartRule-tag-001

	partition MartRule = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("../../data/marts/mart_rule.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Promote = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
			in
			    Promote

	column rule_hit
		lineageTag: MartRule-rule_hit
		dataType: string
		summarizeBy: none

	column alerts
		lineageTag: MartRule-alerts
		dataType: string
		summarizeBy: none

	column amount_at_risk
		lineageTag: MartRule-amount_at_risk
		dataType: string
		summarizeBy: none

	column blocked
		lineageTag: MartRule-blocked
		dataType: string
		summarizeBy: none

	column fp
		lineageTag: MartRule-fp
		dataType: string
		summarizeBy: none

